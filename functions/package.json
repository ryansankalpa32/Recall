{
  "name": "recall-functions",
  "description": "Backend proxy for Recall — holds the Gemini key, exposes /parse-note.",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "test": "npm run build && node --test \"lib/test/**/*.test.js\"",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
