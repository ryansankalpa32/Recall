{
  "name": "recall-server",
  "description": "Standalone Node.js backend for Recall — holds the Gemini key, exposes POST /parse-note.",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node lib/src/index.js",
    "dev": "concurrently \"tsc --watch\" \"node --watch lib/src/index.js\"",
    "test": "npm run build && node --test \"lib/test/**/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.6.0"
  }
}
